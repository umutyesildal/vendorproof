{
  "name": "VendorProof — Orchestrator",
  "nodes": [
    {
      "parameters": {
        "formTitle": "VendorProof — New vendor assessment",
        "formDescription": "Evidence-first vendor due diligence. Enter a company and research objective. Your assessment runs in the background; retrieve it with the same inputs at the report lookup form.",
        "responseMode": "onReceived",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Company",
              "fieldName": "company",
              "requiredField": true
            },
            {
              "fieldLabel": "Research objective",
              "fieldName": "objective",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Start assessment",
          "formSubmittedText": "Assessment started. It runs in the background — retrieve the report at the VendorProof report lookup form using the same company and objective."
        }
      },
      "id": "o01-form",
      "name": "Assessment Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        -1800,
        300
      ],
      "webhookId": "vp-assessment"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "company",
              "value": "={{ String($json['Company'] || $json.company || '').trim().replace(/\\s+/g, ' ') }}",
              "type": "string"
            },
            {
              "id": "n2",
              "name": "objective",
              "value": "={{ String($json['Research objective'] || $json.objective || '').trim().replace(/\\s+/g, ' ') }}",
              "type": "string"
            },
            {
              "id": "n3",
              "name": "report_version",
              "value": "v1",
              "type": "string"
            }
          ]
        },
        "options": {
          "include": "none"
        }
      },
      "id": "o02-normalize",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1580,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.company.length >= 2 && $json.company.length <= 200 && $json.objective.length >= 20 && $json.objective.length <= 2000 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "o03-valid",
      "name": "Inputs Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1360,
        300
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Invalid input: company must be 2-200 chars, objective 20-2000 chars."
      },
      "id": "o04-reject",
      "name": "Reject Input",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        -1140,
        460
      ]
    },
    {
      "parameters": {
        "operation": "hash",
        "type": "SHA256",
        "value": "={{ $json.company.toLowerCase() + '|' + $json.objective.toLowerCase() + '|v1' }}",
        "dataPropertyName": "dedupe_full"
      },
      "id": "o05-crypto",
      "name": "Fingerprint",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        -1140,
        240
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d0a",
              "name": "company",
              "value": "={{ $('Normalize Input').first().json.company }}",
              "type": "string"
            },
            {
              "id": "d0b",
              "name": "objective",
              "value": "={{ $('Normalize Input').first().json.objective }}",
              "type": "string"
            },
            {
              "id": "d0c",
              "name": "report_version",
              "value": "v1",
              "type": "string"
            },
            {
              "id": "d1",
              "name": "dedupe_key",
              "value": "={{ $json.dedupe_full.slice(0, 32) }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "include": "all"
        }
      },
      "id": "o06-key",
      "name": "Dedupe Key",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -920,
        240
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "neu26q9Q8yfqlkxS",
          "mode": "list"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "dedupe_key",
              "condition": "eq",
              "keyValue": "={{ $json.dedupe_key }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "completed"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "o07-cache",
      "name": "Lookup Cached",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -700,
        240
      ],
      "alwaysOutputData": true
