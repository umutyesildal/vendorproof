{
  "name": "VendorProof — Sub: Research Planner",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "s1-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
