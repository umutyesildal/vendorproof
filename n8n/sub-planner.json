      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        60,
        300
      ]
    },
    {
      "parameters": {
        "maxItems": 4
      },
      "id": "s5-limit",
      "name": "Max 4 Queries",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        260,
