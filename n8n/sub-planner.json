        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'MiniMaxAI/MiniMax-M3', temperature: 0.1, max_completion_tokens: 8192, response_format: { type: 'json_schema', json_schema: { name: 'research_plan', strict: true, schema: { type: 'object', properties: { queries: { type: 'array', minItems: 3, maxItems: 4, items: { type: 'object', properties: { query: { type: 'string' }, topic: { type: 'string' }, reason: { type: 'string' } }, required: ['query','topic','reason'], additionalProperties: false } } }, required: ['queries'], additionalProperties: false } } }, messages: [{ role: 'system', content: 'You are the research planner for VendorProof. Decompose the vendor due-diligence objective into 3-4 focused web searches. Prefer official company pricing, security, compliance, docs and status pages first, then reputable independent sources. Each query must target extractable pages.' }, { role: 'user', content: 'Company: ' + $json.company + '\\nObjective: ' + $json.objective }] }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "s2-nebius",
      "name": "Nebius Planner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -380,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "myiguujEgpIHCaZo",
          "name": "vendorproof-nebius"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "queries",
              "value": "={{ JSON.parse($json.choices[0].message.content).queries }}",
              "type": "array"
            },
            {
              "id": "p2",
              "name": "company",
              "value": "={{ $('When Executed by Another Workflow').first().json.company }}",
              "type": "string"
            },
            {
              "id": "p3",
              "name": "objective",
              "value": "={{ $('When Executed by Another Workflow').first().json.objective }}",
              "type": "string"
            },
            {
              "id": "p4",
              "name": "dedupe_key",
              "value": "={{ $('When Executed by Another Workflow').first().json.dedupe_key }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "s3-parse",
      "name": "Parse Plan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "queries",
        "options": {}
      },
      "id": "s4-split",
